# AuditBee - GMP 合规性审计系统配置文件

# ============================================================
# LLM模型配置 (至少配置一个提供商)
# 所有 OpenAI 兼容提供商的 BASE_URL 应包含版本路径 (如 /v1)
# ============================================================

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=

# 通义千问 (Qwen)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=

# 智谱 GLM
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=

# SiliconFlow (支持多种开源模型)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=

# OpenRouter (聚合多家模型)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Mimo / MiniMax
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=

# Agent 默认 LLM 提供商 (可选值: mimo, deepseek, qwen, glm, siliconflow, openai, anthropic, openrouter)
AGENT_LLM_PROVIDER=mimo

# Embedding 模型路径 (用于 LightRAG 知识图谱，默认为项目根目录下的 model/ 文件夹)
# EMBEDDING_MODEL_PATH=./model

# ============================================================
# 飞书配置 (Webhook Bot 群通知，可选)
# 在飞书群设置中添加自定义机器人，复制 Webhook 地址填入下方
# ============================================================
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# ============================================================
# 应用配置
# ============================================================
APP_BASE_URL=http://localhost:8000
TEMPERATURE=0.7
LOG_LEVEL=INFO
MAX_CONCURRENT_TASKS=5
DOCUMENT_PROCESS_TIMEOUT=300
LLM_REQUEST_TIMEOUT=120
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================
# Agent 文档处理配置 (可选，有合理默认值)
# ============================================================
# 结构感知分块的最大字符数 (默认 8000)
# CHUNK_MAX_CHARS=8000
# 文档 ≤ 此大小使用 Stuff 策略 (单次 LLM 调用，默认 60000)
# STUFF_LIMIT=60000
# Stuff 模式下发送给 LLM 的最大文档字符数 (默认 3000)
# MAX_DOCUMENT_CHARS=3000
